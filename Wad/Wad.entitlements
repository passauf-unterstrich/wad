<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Sonderrechte in Wads Signatur: nur das Mikrofon, das die gehärtete Laufzeit sonst sperrt.
     Wad läuft ohne Sandbox. Die eine Anfrage nach Updates braucht deshalb kein eigenes Recht;
     der einzige Netzwerkcode steht in UpdateChecker.swift (SPEC 2.6). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
